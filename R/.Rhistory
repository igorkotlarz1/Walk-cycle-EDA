create_corrplot = function(df, tytul)
{
cor_matrix = cor(df[,-13], use ="complete.obs", method = "pearson")
cor_matrix = round(cor_matrix, 2)
#pozostawienie wartosci ze wspolczynnikiem korelacji >= 0.7
cor_matrix[abs(cor_matrix) < 0.7 ] = NA
cp = corrplot(cor_matrix, method = "number", type ="lower", mar = c(0, 0, 1, 0), title = tytul)
print(cp)
}
create_corrplot(grupa_badana_clean, "Korelacje grupy badanej")
