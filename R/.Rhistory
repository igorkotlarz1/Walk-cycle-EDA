library(readr) #czytanie danych
library(ggplot2) #wizualizacja
library(gridExtra) #wiele wykresow jednoczesnie
library(dplyr) #agregacja
library(tidyr)
library(tidyverse)
ggplot(grupa_long, aes(x = parametr, y = wartosc)) +
geom_boxplot(fill = "lightblue") +
labs(title = "Boxploty parametrów",
x = "Parametr", y = "Wartość") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggplot(grupa_long, aes(y = wartosc)) +
geom_boxplot(fill = "lightblue") +
facet_wrap(~ parametr, scales = "free") +
labs(title = "Boxploty parametrów", y = "Wartość", x = "") +
theme_minimal()
