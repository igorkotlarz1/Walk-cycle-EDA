mann_whitney_test2 = function(df1, df2, alpha, tytul)
{
testy = lapply(names(df1), function(kolumna){
x = df1[[kolumna]]
y = df2[[kolumna]]
if(is.numeric(x) && is.numeric(y))
{
wynik = wilcox.test(x, y, exact = FALSE, alternative = "greater")
return(list(kolumna = kolumna, wynik = wynik))
}
else
{ return(NULL) }
})
testy = Filter(Negate(is.null), testy)
result_df = data.frame(
kolumna = sapply(testy, function(x) x$kolumna),
p_value = sapply(testy, function(x) x$wynik$p.value),
ist_roznicy = sapply(testy, function(x) ifelse(x$wynik$p.value < alpha, "istotna", "nieistotna"))
)
print(paste0("Test istotnosci Manna-Whitneya: ", tytul))
print(result_df)
}
mann_whitney_test2(grupa_badana_clean, grupa_kontrolna_clean, alpha, "wszystkie scenariusze razem")
mann_whitney_test2(badana_las_clean, kontrolna_las_clean, alpha, "scenariusz LAS")
mann_whitney_test2(badana_most_clean, kontrolna_most_clean, alpha, "scenariusz MOST")
mann_whitney_test2(badana_stroop_clean, kontrolna_stroop_clean, alpha, "scenariusz TEST STROOPA")
