remove_outliers_iqr <- function(data) {
numeric_data <- data[sapply(data, is.numeric)]
Q1 <- apply(numeric_data, 2, quantile, 0.25, na.rm = TRUE)
Q3 <- apply(numeric_data, 2, quantile, 0.75, na.rm = TRUE)
IQR <- Q3 - Q1
# identyfikacja outlierów
is_not_outlier <- function(row) {
all(row >= (Q1 - 1.5 * IQR) & row <= (Q3 + 1.5 * IQR))
}
keep <- apply(numeric_data, 1, is_not_outlier)
return(data[keep, ])
}
test_normality <- function(data) {
numeric_data <- data[sapply(data, is.numeric)]
for (col in names(numeric_data)) {
if (nrow(numeric_data) >= 3 && nrow(numeric_data) <= 5000) {
test <- shapiro.test(numeric_data[[col]])
cat(paste0("Kolumna: ", col,
" | p-value: ", round(test$p.value, 5),
" => ", ifelse(test$p.value > 0.05, "normalny", "nienormalny"), "\n"))
} else {
cat(paste0("Kolumna: ", col, " | Za dużo lub za mało danych do testu Shapiro-Wilka\n"))
}
}
}
df_clean <- remove_outliers_iqr(badana_las)
test_normality(df_clean)
test_normality <- function(data) {
numeric_data <- data[sapply(data, is.numeric)]
for (col in names(numeric_data)) {
if (nrow(numeric_data) >= 3 && nrow(numeric_data) <= 5000) {
test <- shapiro.test(numeric_data[[col]])
cat(paste0("Kolumna: ", col,
" | p-value: ", round(test$p.value, 5),
" => ", ifelse(test$p.value > 0.00417, "normalny", "nienormalny"), "\n"))
} else {
cat(paste0("Kolumna: ", col, " | Za dużo lub za mało danych do testu Shapiro-Wilka\n"))
}
}
}
test_normality(df_clean)
