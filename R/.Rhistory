create_boxplots(grupa2, grupa_badana,"fazy.png", "darkorange")
create_boxplots(grupa3, grupa_badana,"podparcia.png", "limegreen")
create_boxplots(grupa4, grupa_badana,"tempa.png", "lightcoral")
