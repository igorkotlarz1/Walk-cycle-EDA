mann_whitney_test = function(df1, df2, alpha)
{
testy = lapply(names(df1), function(kolumna){
x = df1[[kolumna]]
y = df2[[kolumna]]
if(is.numeric(x) && is.numeric(y))
{
wynik = wilcox.test(x, y, exact = FALSE)
return(list(kolumna = kolumna, wynik = wynik))
}
else
{ return(NULL) }
})
testy = Filter(Negate(is.null), testy)
result_df = data.frame(
kolumna = sapply(testy, function(x) x$kolumna),
p_value = sapply(testy, function(x) x$wynik$p.value),
istotnosc = sapply(testy, function(x) ifelse(x$wynik$p.value < alpha, "istotna", "nieistotna"))
)
print(result_df)
}
mann_whitney_test = function(df1, df2, alpha, tytul)
{
testy = lapply(names(df1), function(kolumna){
x = df1[[kolumna]]
y = df2[[kolumna]]
if(is.numeric(x) && is.numeric(y))
{
wynik = wilcox.test(x, y, exact = FALSE)
return(list(kolumna = kolumna, wynik = wynik))
}
else
{ return(NULL) }
})
testy = Filter(Negate(is.null), testy)
result_df = data.frame(
kolumna = sapply(testy, function(x) x$kolumna),
p_value = sapply(testy, function(x) x$wynik$p.value),
istotnosc = sapply(testy, function(x) ifelse(x$wynik$p.value < alpha, "istotna", "nieistotna"))
)
print("Test istotnosci Manna-Whitneya ", tytul)
print(result_df)
}
